# =============================================================================
# MODELO DE VARIÁVEIS DE AMBIENTE - BACKEND (Copie para .env.development ou .env.production)
# =============================================================================
NODE_ENV=development
PORT=3001

# Banco de Dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=jhe_organograma
DB_SSL=false
DB_CONNECTION_LIMIT=15

# Segurança e Autenticação JWT
JWT_SECRET=substitua_por_uma_chave_secreta_forte_de_64_bytes
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# CORS (Origens permitidas separadas por vírgula)
CORS_ORIGIN=http://localhost:5173
SERVE_STATIC_FRONTEND=false
